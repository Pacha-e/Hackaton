SECRET_KEY=django-insecure-cambia-esto-en-produccion-generado-con-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pqrsddb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ============================================
# GEMINI (Google AI Studio - GRATIS)
# Obtener en: https://aistudio.google.com/app/apikey
# ============================================
GEMINI_API_KEY=tu-api-key-de-google-ai-studio

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ============================================
# LANGSMITH (Observabilidad de LangChain)
# Obtener en: https://smith.langchain.com
# Crear cuenta gratis → Settings → API Keys
# ============================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=tu-api-key-de-langsmith
LANGCHAIN_PROJECT=OmegaHack2026-PQRSD

# ============================================
# LANGFUSE (Alternativa de observabilidad - opcional)
# Obtener en: https://cloud.langfuse.com
# ============================================
# LANGFUSE_PUBLIC_KEY=tu-public-key
# LANGFUSE_SECRET_KEY=tu-secret-key
# LANGFUSE_HOST=https://cloud.langfuse.com
