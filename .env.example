SECRET_KEY=django-insecure-cambia-esto-en-produccion-generado-con-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=pqrsddb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

GEMINI_API_KEY=tu-api-key-de-google-ai-studio

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Webhook Chatwoot → Django (opcional; cabecera X-Webhook-Token)
CHATWOOT_WEBHOOK_SECRET=cambia-este-secreto-compartido-con-la-cabecera-X-Webhook-Token
# Tras radicar desde Chatwoot, ejecutar clasificación Gemini (True/False)
CHATWOOT_AUTO_CLASIFICAR=True

# Chatwoot: copia .env.chatwoot.example → .env.chatwoot (archivo separado del .env de Django)
