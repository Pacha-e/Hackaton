# Copiar a .env.chatwoot — solo usado por contenedores Chatwoot (Rails + Sidekiq).
# Documentación: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables

SECRET_KEY_BASE=genera-con-rake-secret-o-openssl-rand-hex-64
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true

POSTGRES_HOST=chatwoot_postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=elkiko123
POSTGRES_DATABASE=chatwoot_production
RAILS_ENV=production
RAILS_MAX_THREADS=5

REDIS_URL=redis://:elkiko123@chatwoot_redis:6379
REDIS_PASSWORD=elkiko123

MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.com>
SMTP_DOMAIN=chatwoot.com
SMTP_ADDRESS=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
